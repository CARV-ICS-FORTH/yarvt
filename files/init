#!/bin/bash

##################
# CONSOLE OUTPUT #
##################

function pr_ann () {
	echo -e "\e[32m \n--=== ${1} ===--\e[0m"
}

function pr_inf () {
	echo -e "\e[36m${1}\e[0m"
}

function pr_wrn () {
	echo -e "\e[33m${1}\e[0m"
}

function pr_err () {
	>&2 echo -e "\e[31m${1}\e[0m"
}

###########
# HELPERS #
###########

# Echo the value of a kernel cmdline parameter (NAME=value), or nothing for a
# bare flag (NAME). Returns 0 if the parameter is present, 1 otherwise. Lets
# callers read what they need in local scope instead of a pile of globals.
function var_from_cmdline () {
	local arg=""

	for arg in $(cat /proc/cmdline); do
		case "${arg}" in
			"${1}"=*)
				echo "${arg#*=}"
				return 0
				;;
			"${1}")
				return 0
				;;
		esac
	done
	return 1
}

# Clean shutdown as PID 1: busybox halt/poweroff/reboot signal init (us), so
# unmount everything and issue the requested action with -f, which calls the
# reboot() syscall directly instead of signalling init again.
function shutdown_handler () {
	pr_inf "Shutting down (${1})"
	umount -a -r &> /dev/null
	"${1}" -f
}

# Replace this initramfs with the installed system mounted at ${1}, handing
# control to its /sbin/init. This must run as PID 1 (which is why this script is
# /init and stays PID 1), otherwise busybox switch_root refuses.
function do_switch_root () {
	exec switch_root ${1} /sbin/init
}

#########
# SETUP #
#########

# Mount the pseudo filesystems and create the bits of /dev and / that the rest
# of the script expects to be there.
function prepare_root_hierarchy () {
	mount -t devtmpfs none /dev
	mkdir /dev/pts
	mount -t devpts devpts /dev/pts
	mount -t proc -o nodev,noexec,nosuid proc /proc
	mount -t sysfs -o nodev,noexec,nosuid sysfs /sys
	mknod -m 622 /dev/console c 5 1 &> /dev/null
	mkdir /tmp
}

# Quiet the kernel log on the console, build a small motd and greet the user.
function init_console () {
	dmesg -n1
	echo "$(uname -s -v -r -p -m)" >> /etc/motd
	pr_ann "Welcome to RISC-V"
}

# Make sure the storage drivers are up so the backing disk shows up before we go
# looking for it: virtio-blk (QEMU's default backend) is usually built in, and
# NVMe (the disk on real hardware, QEMU's debug backend) may be a module we load
# if a controller is present. The virtio-blk nudge is a harmless no-op on a real
# hardware kernel that has no such driver.
function load_storage () {
	modprobe virtio_blk &> /dev/null

	# Nothing more to do without an NVMe controller (PCI class 0108) on the bus.
	if ! lspci | grep -q "Class 0108"; then
		return 0
	fi

	# Already bound - built in, or the module is already loaded.
	if ls /dev/nvme* &> /dev/null; then
		return 0
	fi

	# Controller present but unbound: load the driver.
	modprobe nvme_core &> /dev/null
	modprobe nvme &> /dev/null
}

# Bring up loopback and eth0, apply the requested hostname and get an IPv4 lease
# via DHCP. Best effort: returns 1 if eth0 ends up without an address, so the
# caller can decide whether that's fatal (installers, NFS) or not (disk boot).
# Idempotent - does nothing if eth0 is already configured (previous call or
# kernel ip= autoconf).
function init_network () {
	local HN=$(var_from_cmdline systemd.hostname)

	ip link set lo up &> /dev/null
	ip addr add 127.0.0.1 dev lo &> /dev/null
	ip route add 127.0.0.0/255.0.0.0 dev lo &> /dev/null

	[[ "${HN}" != "" ]] && hostname "${HN}"

	ip link show eth0 &> /dev/null || return 1

	if ip addr show dev eth0 | grep -q "inet "; then
		return 0
	fi

	ip link set eth0 up &> /dev/null
	# Foreground, but bounded: up to 5 discovers ~1s apart (~5s) then give up
	# (-n) so a boot that doesn't need networking never hangs here.
	udhcpc -f -q -n -t 5 -T 1 &> /dev/null

	ip addr show dev eth0 | grep -q "inet "
}

# Create the root user (password "riscv") for the local diagnostics environment.
# Only needed when we drop to the console - the system we switch_root into brings
# its own, so there's no point setting this up in the root hierarchy otherwise.
function setup_credentials () {
	echo "root:\$5\$H2cul7fEFgcApal5\$EA0DmjYXIJ8UWS.mnRC3rF4F2UXUpA3KsAhF/.m/eq.:0:0:99999:7:::" > /etc/shadow
	chmod go-rw /etc/shadow
	echo "root:x:0:0:System administrator,,,:/root:/bin/bash" > /etc/passwd
	chmod go-w /etc/passwd
	echo "/bin/bash" > /etc/shells
	echo "root:x:0:" > /etc/group
	echo "root:*::" > /etc/gshadow
	chmod go-rw /etc/gshadow
}

############
# BACKENDS #
############

# Handle a requested storage backend (yarvt.bootmode): either switch_root into
# an already-installed system on it, or run the installer for yarvt.distro under
# apkify. Only returns (letting the caller drop to a rescue shell, or to the
# default environment when there's nothing to install) on failure / no-op - a
# successful boot or install replaces this process.
function boot_or_install () {
	local BOOTMODE=$(var_from_cmdline yarvt.bootmode)
	local DISTRO=$(var_from_cmdline yarvt.distro)
	local NFS_PREFIX=$(var_from_cmdline yarvt.nfs_prefix)
	local ROOT_DEV=""
	local i=0

	case "${BOOTMODE}" in
		disk)
			# Wait for the local disk to appear: virtio-blk (vda) under QEMU, or
			# NVMe (nvme0n1) on real hardware (and QEMU's debug backend).
			while [[ ${i} -lt 5 ]]; do
				if [[ -b /dev/vda ]] || [[ -b /dev/nvme0n1 ]]; then
					break
				fi
				sleep 1
				i=$((i + 1))
			done
			if [[ ! -b /dev/vda ]] && [[ ! -b /dev/nvme0n1 ]]; then
				pr_err "yarvt.bootmode=disk but no local disk found"
				return 1
			fi
			ROOT_DEV=$(blkid | grep 'LABEL="yarvt-root"' | head -1)
			ROOT_DEV=${ROOT_DEV%%:*}
			if [[ "${ROOT_DEV}" != "" ]]; then
				mkdir -p /mnt/target
				mount "${ROOT_DEV}" /mnt/target
				if [[ -x /mnt/target/sbin/init ]]; then
					pr_ann "Booting installed system on ${ROOT_DEV}"
					do_switch_root /mnt/target
				fi
				umount /mnt/target &> /dev/null
			fi
			;;
		nfs)
			if [[ "${NFS_PREFIX}" == "" ]]; then
				pr_err "yarvt.bootmode=nfs but no yarvt.nfs_prefix given"
				return 1
			fi
			if ! init_network; then
				pr_err "Network is down, can't reach the NFS export"
				return 1
			fi
			mkdir -p /mnt/target
			mount -tnfs4 -orsize=8192,wsize=8192 10.0.2.2:${NFS_PREFIX} /mnt/target
			if [[ $? != 0 ]]; then
				pr_err "Couldn't mount NFS export ${NFS_PREFIX}"
				return 1
			fi
			if [[ -x /mnt/target/sbin/init ]]; then
				pr_ann "Booting installed system over NFS"
				do_switch_root /mnt/target
			fi
			;;
		*)
			pr_err "Unknown yarvt.bootmode=${BOOTMODE}"
			return 1
			;;
	esac

	# Nothing is installed on the backend. If no distro was requested the user
	# just wanted the backend available, so return success and let init start the
	# default environment instead of dropping to a rescue shell.
	if [[ "${DISTRO}" == "" ]]; then
		pr_inf "Nothing installed on ${BOOTMODE}, starting the default environment"
		return 0
	fi
	if [[ "${DISTRO}" != "alpine" ]] && [[ "${DISTRO}" != "ubuntu" ]]; then
		pr_err "yarvt.distro must be alpine or ubuntu (got '${DISTRO}')"
		return 1
	fi

	# A distro was requested: run its installer under apkify (which gives it
	# Alpine + bash + apk). It halts/reboots when done - cleanly, since we handle
	# those signals - so this normally doesn't return.
	if ! init_network; then
		pr_err "Network is down, can't run the installer"
		return 1
	fi
	pr_ann "No system installed on ${BOOTMODE}, running the ${DISTRO} installer"
	apkify installer-${DISTRO}
	return 1
}

###########
# CONSOLE #
###########

# The default / rescue environment: we didn't boot or install anything, so set
# up credentials, logging, networking and (if built in) the ssh daemon, then run
# a console login (or a plain root shell in rescue mode) and stay PID 1 to reap
# children. These daemons are started only here on purpose - there's no point
# running things we won't use or that would clash with a system we're booting.
function run_console () {
	# Rescue mode - a plain root shell instead of a login prompt - is requested
	# with 'rescue' on the kernel cmdline.
	local SINGLE=0
	if var_from_cmdline rescue &> /dev/null; then
		SINGLE=1
	fi

	setup_credentials
	syslogd -K
	if init_network && command -v dropbear &> /dev/null; then
		mkdir -p /etc/dropbear /usr/bin
		dropbear -R -m -b /etc/motd &
		ln -s /bin/dropbearmulti /usr/bin/dbclient
		pr_inf "You may also login over ssh (host port 2222 with QEMU) as root/riscv"
	fi

	if [[ ${SINGLE} -eq 0 ]]; then
		pr_inf "Use root/riscv to login"
	else
		cat /etc/motd
	fi

	echo "export PS1=\"\$(id -un)@\$(hostname): \${PWD} $ \"" > /root/.profile

	while true; do
		# Run the shell in a new session as a fork, so that we can wait for traps
		# and handle them (halt/reboot etc).
		if [[ ${SINGLE} -eq 0 ]]; then
			setsid cttyhack /bin/login &
		else
			setsid cttyhack /bin/bash &
		fi

		# Only re-try when the previous run exits, otherwise this becomes
		# a fork bomb.
		local PID=$!
		while kill -0 "$PID" 2>/dev/null; do
			sleep 1
		done

		# This is to be on the safe side in case shell fails to run
		sleep 1;
	done
}

########
# MAIN #
########

function main () {
	prepare_root_hierarchy

	# We run as PID 1, so busybox halt/poweroff/reboot signal us - trap those and
	# shut down cleanly ourselves.
	trap 'shutdown_handler halt'     USR1
	trap 'shutdown_handler poweroff' USR2
	trap 'shutdown_handler reboot'   TERM

	init_console
	load_storage

	# If a storage backend was requested (and we weren't forced into rescue), try
	# to boot the system installed on it or run its installer. boot_or_install
	# replaces this process on success and only returns (dropping to the console
	# below) on failure or when there's nothing to do.
	if [[ "$(var_from_cmdline yarvt.bootmode)" != "" ]] && ! var_from_cmdline rescue &> /dev/null; then
		boot_or_install
	fi

	run_console
}

main
