 #endif
 
+#define FCS_STATE_RUNNING 0
+#define FCS_STATE_WAITING 1
+#define FCS_STATE_WAKING  2
+#define FCS_STATE_NOWAIT  3
+
+static void fcs_init(struct task_struct *p)
+{
+	spin_lock_init(&p->fcs.lock);
+	p->fcs.state = FCS_STATE_RUNNING;
+	p->fcs.cpumaskp = NULL;
+	p->fcs.flags = FCS_FLAGS_NONE;
+
+#ifdef CONFIG_FCS_STATS
+	atomic_set(&p->fcs.fast, 0);
+	atomic_set(&p->fcs.slow_immediate, 0);
+	atomic_set(&p->fcs.slow_deferred, 0);
+	atomic_set(&p->fcs.setaffinity, 0);
+#endif
+
+#ifdef CONFIG_FCS_DEBUG
+	p->fcs.type = "init";
+	atomic_set(&p->fcs.debug_head, 0);
+	for (int i = 0; i < FCS_DEBUG_SIZE; i++)
+		p->fcs.debug[i] = NULL;
+	p->fcs.wait_id = -1;
+#endif
+}
+
+void fcs_exit(struct task_struct *p)
+{
+#ifdef CONFIG_FCS_STATS
+	unsigned int fast = (unsigned int) atomic_read(&p->fcs.fast);
+	unsigned int slow_immediate = (unsigned int) atomic_read(&p->fcs.slow_immediate);
+	unsigned int slow_deferred  = (unsigned int) atomic_read(&p->fcs.slow_deferred);
+	unsigned int slow_setaffinity  = (unsigned int) atomic_read(&p->fcs.setaffinity);
+
+	if (slow_deferred || slow_immediate || fast)
+		pr_info("fcs stats: fast=%u slow.immediate=%u slow.deferred=%u slow.setaffinity=%u total=%u\n",
+			fast, slow_immediate, slow_deferred,
+			slow_setaffinity,
+			fast + slow_immediate + slow_deferred);
+#endif
+}
+
+static int do_fcs(struct task_struct *p, cpumask_t *in_mask,
+		  char do_block, char bypass);
+
+static long fcs_restart(struct restart_block *restart)
+{
+	restart->fn = do_no_restart_syscall;
+	// we call it with current to avoid waking someone else
+	return do_fcs(current, NULL, 1, 0);
+}
+
+#ifdef CONFIG_FCS_DEBUG
+static const char *fcs_type(char block, char wake)
+{
+	if (block) {
+		if (wake)
+			return "full";
+		return "block";
+	} else {
+		if (wake)
+			return "wake";
+		return "inval";
+	}
+}
+
+static atomic_t fcs_op;
+static int fcs_get_op_id(void)
+{
+	return atomic_fetch_inc_relaxed(&fcs_op);
+}
+#endif
+
+void pr_fcs(struct task_struct *p, const char *msg) {
+#ifdef CONFIG_FCS_DEBUG
+	if (!p)
+		return;
+	int head = atomic_fetch_inc_relaxed(&p->fcs.debug_head);
+	WRITE_ONCE(p->fcs.debug[head % FCS_DEBUG_SIZE], msg);
+#endif
+}
+
+static void fcs_stat_setaffinity(struct task_struct *p)
+{
+#ifdef CONFIG_FCS_STATS
+	atomic_inc(&p->group_leader->fcs.setaffinity);
+#endif
+}
+
+static void fcs_stat_fast(struct task_struct *p)
+{
+#ifdef CONFIG_FCS_STATS
+	atomic_inc(&p->group_leader->fcs.fast);
+#endif
+}
+
+static void fcs_stat_slow_immediate(struct task_struct *p)
+{
+#ifdef CONFIG_FCS_STATS
+	atomic_inc(&p->group_leader->fcs.slow_immediate);
+#endif
+}
+
+static void fcs_stat_slow_deferred(struct task_struct *p)
+{
+#ifdef CONFIG_FCS_STATS
+	atomic_inc(&p->group_leader->fcs.slow_deferred);
+#endif
+}
+
+static int fcs_wake(struct task_struct *next, cpumask_t *in_mask)
+{
+	int cpu;
+	int ret;
+	struct affinity_context ac;
+	int current_cpu;
+	cpumask_t *cpumaskp;
+	struct task_struct *prev = current;
+
+	// This thread might block at the end of this function. We call this
+	// funxtion with preemption disabled to avoid a scheduling point to
+	// preempt us before reaching the blocking point. We do so for
+	// performance, to avoid spurious wake ups.
+
+	if (next == prev)
+		return 0;
+
+	current_cpu = smp_processor_id();
+
+	// wake up a thread
+	spin_lock(&next->fcs.lock);
+	if (next->fcs.state == FCS_STATE_WAITING) {
+		// The thread that we want to wake up has marked itself
+		// as waiting to be woken up already. At this point, the
+		// theread might be still on the runqueue (about to
+		// schedule) or might have already been removed from it.
+		//
+		// If it has been removed from it, it this is the ideal
+		// place to change it's affinity before waking it up.
+		//
+		// If it is still running, it might seem risky migrating
+		// it to this cpu right now because it might preempt us,
+		// but this is really not possible because preemption on
+		// this core is disabled right now. In the worse case,
+		// we will migrate a thread that is about to call
+		// schedule.  But the good news is that in this case,
+		// the thread will not easily preempt us (it could
+		// preempt us just when we call preempt_enable(), but we
+		// are careful and call instead
+		// preempt_enable_no_resched(). It could still happen if
+		// a timer interrupt arrives just after we drop
+		// preemption, but it is highly unlikely.
+
+		next->fcs.state = FCS_STATE_WAKING;
+
+		// As soon as we drop this lock, the thread that we want
+		// to wake up might return to user-space if it gets a
+		// spurious wake up and sees FCS_STATE_WAKING. However,
+		// we would still need to migrate it. If we let the
+		// thread return to user-space before we migrate it, we
+		// migth end up doing so while the thread has a
+		// user-space lock held, which we want to avoid for
+		// perfomance. However, because it is an extremely
+		// unlikely event, we let it pass.
+
+		spin_unlock(&next->fcs.lock);
+
+		fcs_stat_slow_immediate(prev);
+		pr_fcs(prev, "fcs: slow: immediate wake (ttwu)");
+		pr_fcs(next, "pov: fcs: slow: immediate waking me (ttwu)");
+		//pr_info("%d: %d: %dwi: type: %s: slow: wake now: %d\n",
+		//       current_cpu, prev->pid, next->fcs.wait_id, prev->fcs.type, next->pid);
+
+		cpumaskp = (in_mask) ? in_mask : (cpumask_t *) cpumask_of(current_cpu);
+
+		// we need to change the wakee affinity
+		if (!cpumask_equal(cpumaskp, &next->cpus_mask)) {
+			ac = (struct affinity_context){
+				.new_mask  = cpumaskp,
+				.flags     = 0,
+			};
+
+			// we need to enable preemption again because
+			// __sched_setaffinity might trigger a call to
+			// schedule(), which will throw a "scheduling while
+			// atomic" bug
+			// TODO avoid enabling preemption
+			preempt_enable_no_resched();
+			if (likely(same_thread_group(next, prev) && (!in_mask))) {
+				// same as __sched_setaffinity but do no
+				// check cgroup permissions to skip
+				// locking for threads belonging to the
+				// same process that swap cpus
+				ret = fcs_sched_setaffinity(next, &ac);
+			} else {
+				// either we are swaping for a thread of
+				// another process or the user provided
+				// a custom cpu mask. We need to do
+				// cgroup checks.
+				fcs_stat_setaffinity(prev);
+				ret = __sched_setaffinity(next, &ac);
+			}
+			if (unlikely(ret)) {
+				pr_err("fcs: %d: state=WAITING: __sched_setaffinity returned %d\n", prev->pid, ret);
+				for_each_cpu(cpu, in_mask) {
+					pr_err("cpu %d\n", cpu);
+				}
+				pr_err("end cpuset dump\n");
+				return ret;
+			}
+			preempt_disable();
+		}
+
+		wake_up_process(next);
+	} else if (next->fcs.state == FCS_STATE_RUNNING) {
+		// The thread has not marked itself to be waiting yet.
+		//
+		// Because we don't know how long it will take for the
+		// thread to try to block itself, we pass it the
+		// affinity of the current thread and we ask it to
+		// migrate itself once it calls fcs.
+
+#ifdef CONFIG_FCS_DEBUG
+		next->fcs.wait_id = fcs_get_op_id();
+#endif
+		next->fcs.state = FCS_STATE_NOWAIT;
+		if (unlikely(in_mask)) {
+			cpumask_copy(&next->fcs.cpumask, in_mask);
+			next->fcs.flags |= FCS_FLAGS_USERMASK;
+		} else {
+			next->fcs.cpumaskp = (cpumask_t *) cpumask_of(current_cpu);
+		}
+		if (unlikely(!same_thread_group(next, prev) || in_mask)) {
+			next->fcs.flags |= FCS_FLAGS_CGROUP_CHECK;
+		}
+		spin_unlock(&next->fcs.lock);
+
+		fcs_stat_slow_deferred(prev);
+		pr_fcs(prev, "fcs: slow: wake deferred");
+		pr_fcs(next, "pov: fcs: slow: waking me deferred");
+		//pr_info("%d: %d: %dwi: type: %s: slow: wake later: %d\n",
+		//       current_cpu, prev->pid, next->fcs.wait_id, prev->fcs.type, next->pid);
+	} else {
+		int state = next->fcs.state;
+		spin_unlock(&next->fcs.lock);
+		pr_err("%d: fcs core: wake: INVAL STATE %d\n", prev->pid, state);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+
+static int fcs_wait(void)
+{
+	int ret;
+	int cpu;
+	cpumask_t *cpumaskp;
+	cpumask_t cpumask;
+	struct restart_block *restart;
+	struct affinity_context ac;
+	char user_mask;
+	char need_cgroup_check;
+
+	int current_cpu = smp_processor_id();
+
+	// Block the current thread, if needed.
+	spin_lock(&current->fcs.lock);
+	if (current->fcs.state == FCS_STATE_NOWAIT) {
+		// Someone has woken us up already. Therefore the current thread
+		// doesn't need to block here, but it might need to migrate to
+		// another core.
+		need_cgroup_check = current->fcs.flags & FCS_FLAGS_CGROUP_CHECK;
+		user_mask = current->fcs.flags & FCS_FLAGS_USERMASK;
+		if (unlikely(user_mask)) {
+			cpumask_copy(&cpumask, &current->fcs.cpumask);
+			cpumaskp = &cpumask;
+		} else {
+			cpumaskp = current->fcs.cpumaskp;
+		}
+		current->fcs.cpumaskp = NULL;
+		current->fcs.flags = FCS_FLAGS_NONE;
+		current->fcs.state = FCS_STATE_RUNNING;
+
+		spin_unlock(&current->fcs.lock);
+
+		//pr_info("%d: %d: %dwi: type: %s: slow: wait fast\n",
+		//       current_cpu, current->pid, current->fcs.wait_id, current->fcs.type);
+		pr_fcs(current, "fcs: slow: wait fast");
+
+		preempt_enable_no_resched();
+
+		if (!cpumask_equal(cpumaskp, &current->cpus_mask)) {
+			ac = (struct affinity_context){
+				.new_mask  = cpumaskp,
+				.flags     = 0,
+			};
+			if (unlikely(need_cgroup_check)) {
+				// the user passed a custom affinity mask, we
+				// need to check cgroups
+				fcs_stat_setaffinity(current);
+				ret = __sched_setaffinity(current, &ac);
+			} else {
+				// we are swapping a core with a thread that
+				// belongs to this process, no need to check
+				// cgroups affinity
+				ret = fcs_sched_setaffinity(current, &ac);
+			}
+			if (unlikely(ret)) {
+				pr_err("fcs: %d: state=NOWAIT: __sched_setaffinity returned %d\n", current->pid, ret);
+				for_each_cpu(cpu, cpumaskp) {
+					pr_err("cpu %d\n", cpu);
+				}
+				pr_err("end cpuset dump\n");
+				return ret;
+			}
+		}
+
+		preempt_disable();
+	} else if (current->fcs.state == FCS_STATE_RUNNING) {
+		// Nobody attempted to wake this thread yet. Therefore, it must
+		// block until someone wakes it up.
+
+		current->fcs.state = FCS_STATE_WAITING;
+#ifdef CONFIG_FCS_DEBUG
+		current->fcs.wait_id = fcs_get_op_id();
+#endif
+
+		// As soon as we go outside the lock, another thread might
+		// attempt to wake us up, even if we have not yet blocked.
+		// However, that's fine, because wake_up_process() (aka
+		// try_to_wake_up) will change our state to TASK_RUNNING, and
+		// calling schedule() below won't desquedule us. Schedule()
+		// might still do a context switch, but because it has not
+		// descheduled us, it will run us again at some point, we will
+		// loop, and the condition check will save the day.
+		//
+		// try_to_wake_up and schedule() need to synchronize to avoid
+		// missing a wake up (imagine a thread calling try_to_wake_up()
+		// on thread A before thread A reaches schedule()). They do so
+		// using p->__state, p->on_rq and rq_lock(). p->on_rq is 1 only
+		// if the thread is still on the run queue. p->__state is what
+		// we intentd to do. i.e. we want to put the thread to sleep, so
+		// we set the state to TASK_UNINTERRUPTIBLE and then we call
+		// schedule() to ask it to actually block it. If we call
+		// schedule while our state is TASK_RUNNING, schedule() won't
+		// remove us from the run queue, which means that the thread
+		// won't block.
+		//
+		// So, a thread A sets itself to TASK_UNINTERRUPTIBLE and then
+		// calls schedule(). In between setting __state and calling
+		// schedule(), another thread calls
+		// wake_up_process(). wake_up_process will take the run queue
+		// lock to serialize against schedule and will check on_rq to
+		// see if the thread is really blocked or not. Because it is
+		// still running on_rq is 1, and we now now that it has not yet
+		// calling schedule(). To avoid the thread from blocking,
+		// try_to_wake_up() sets __state to
+		// TASK_RUNNING, unlocks the run queue, and returns.
+		// When thread A calls schedule, it will take the runqueue lock.
+		// Then it will check __state and it will see that it is still
+		// TASK_RUNNING, so it won't remove it from the run queue.
+		// However, it might still perform a context switch if another
+		// thread needs to preempt us. However, because thread A is
+		// still on the run queue, it will be scheduled again at some
+		// point.
+
+		for (;;) {
+			if (current->fcs.state == FCS_STATE_WAKING)
+				break;
+
+			if (signal_pending(current)) {
+				ret = -ERESTARTSYS;
+				restart = &current->restart_block;
+				set_restart_fn(restart, fcs_restart);
+				break;
+			}
+
+			spin_unlock(&current->fcs.lock);
+
+			current_cpu = smp_processor_id();
+			//pr_info("%d: %d: %dwi: type: %s: slow: wait slow\n",
+			//       current_cpu, current->pid, current->fcs.wait_id, current->fcs.type);
+			pr_fcs(current, "fcs: slow: wait slow (schedule())");
+
+			set_current_state(TASK_INTERRUPTIBLE);
+
+			preempt_enable_no_resched();
+
+			schedule();
+
+			preempt_disable();
+			spin_lock(&current->fcs.lock);
+		}
+		__set_current_state(TASK_RUNNING);
+		current->fcs.state = FCS_STATE_RUNNING;
+		spin_unlock(&current->fcs.lock);
+
+		current_cpu = smp_processor_id();
+		//pr_info("%d: %d: %dwi: type: %s: slow: wait return\n",
+		//       current_cpu, current->pid, current->fcs.wait_id, current->fcs.type);
+		pr_fcs(current, "fcs: slow return");
+
+		// At this point, the current thread has been migrated by the
+		// waking thread (unless we are here because of a signal).
+	} else {
+		int state = current->fcs.state;
+		spin_unlock(&current->fcs.lock);
+		pr_err("%d: fcs core: wait: INVAL STATE %d\n", current->pid, state);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int do_fcs_slow(struct task_struct *next, cpumask_t *in_mask, char block)
+{
+	int ret;
+	struct task_struct *prev = current;
+
+	pr_fcs(prev, "fcs: slow");
+
+	ret = fcs_wake(next, in_mask);
+	if (ret || !block)
+		return ret;
+
+	return fcs_wait();
+}
+
+static void fcs_swap_se(struct sched_entity *pse, struct sched_entity *nse)
+{
+	swap(pse->load, nse->load);
+	//swap(pse->run_node, nse->run_node); // TODO ok?
+	swap(pse->deadline, nse->deadline);
+	swap(pse->min_vruntime, nse->min_vruntime);
+	swap(pse->on_rq, nse->on_rq); // TODO ok?
+	swap(pse->exec_start, nse->exec_start);
+	swap(pse->sum_exec_runtime, nse->sum_exec_runtime);
+	swap(pse->prev_sum_exec_runtime, nse->prev_sum_exec_runtime);
+	swap(pse->vruntime, nse->vruntime);
+	swap(pse->vlag, nse->vlag);
+	swap(pse->slice, nse->slice);
+	swap(pse->nr_migrations, nse->nr_migrations); // TODO needed?
+	swap(pse->runnable_weight, nse->runnable_weight); // TODO needed?
+	swap(pse->avg, nse->avg); // TODO needed?
+}
+
+static int do_fcs_fast(struct task_struct *next)
+{
+	struct task_struct *prev = current;
+	struct rq_flags rf;
+	struct rq *rq;
+	struct affinity_context ac;
+	const cpumask_t *cpumaskp;
+	int current_cpu;
+	int ret = 0;
+	struct restart_block *restart;
+
+	// If the current task needs to be preempted, take the slow-path. By
+	// calling schedule() we let the scheduler choose what to run next
+	// (which might be something more important that we want to run next in
+	// fcs).
+	if (test_tsk_need_resched(prev) || test_preempt_need_resched())
+		goto out;
+
+	if (!spin_trylock(&prev->fcs.lock))
+		goto out;
+
+	if (!spin_trylock(&next->fcs.lock))
+		goto out_prev;
+
+	if (prev->fcs.state != FCS_STATE_RUNNING || next->fcs.state != FCS_STATE_WAITING)
+		goto out_next;
+
+	// We need to disable irqs before taking pi_lock, as pi_lock might be
+	// taken from irq context.
+	local_irq_disable();
+	// TODO we might end up calling rcu_note_context_switch twice if we end
+	// up in the slow path and call schedule(). Is it safe?
+	rcu_note_context_switch(0);
+
+	// serialize against ttwu
+	if (!raw_spin_trylock(&next->pi_lock))
+		goto out_irq;
+
+	// TODO should I use "&" to check TASK_UNINTERRUPTIBLE?
+	// smp_load_acquire(&next->on_cpu) orders memory with respect the core where it last run.
+	if (smp_load_acquire(&next->on_cpu) || READ_ONCE(next->on_rq) || (READ_ONCE(next->__state) != TASK_INTERRUPTIBLE))
+		goto out_pi;
+
+	// needs to be set before smp_mb__after_spinlock() to avoid races with
+	// signal_wake_up(), which might end up with the task hung after a
+	// SIGTERM. See note on __schedule() (search for signal_wake_up());
+	set_current_state(TASK_INTERRUPTIBLE);
+	// lock the current rq
+	current_cpu = smp_processor_id();
+	rq = cpu_rq(current_cpu);
+	// NOTE: rcu_note_context_switch should go here, but lockdep complains about
+	// incorrect lock ordering. The correct ordering is: first the lock in
+	// rcpu_note_context_switch, then the pi_lock.
+	//rcu_note_context_switch(0);
+	rq_lock(rq, &rf);
+	smp_mb__after_spinlock();
+
+	// check for pending signals
+	if (signal_pending(prev)) {
+		// TODO is it ok to set the task state here?
+		__set_current_state(TASK_RUNNING);
+		goto out_rq;
+	}
+
+	// fcs fast-path
+
+#ifdef CONFIG_FCS_DEBUG
+	prev->fcs.wait_id = fcs_get_op_id();
+#endif
+	prev->fcs.state = FCS_STATE_WAITING;
+	next->fcs.state = FCS_STATE_WAKING;
+	spin_unlock(&next->fcs.lock);
+	spin_unlock(&prev->fcs.lock);
+
+	fcs_stat_fast(prev);
+
+	//pr_info("%d: %d: %dwi: fast: %d (%dwi)\n",
+	//	current_cpu, prev->pid, prev->fcs.wait_id, next->pid, next->fcs.wait_id);
+	pr_fcs(prev, "fcs: fast: switch");
+	pr_fcs(next, "pov: fcs: fast: waking me");
+
+	// TODO called on deactivate_task()
+	//sched_info_dequeue(rq, next);
+	//psi_dequeue(next, DEQUEUE_SLEEP);
+	//psi_enqueue(next, 1);
+
+	WRITE_ONCE(next->on_rq, 1);
+
+	// Check if we need to change the wakee affinity?
+	cpumaskp = cpumask_of(current_cpu);
+	if (!cpumask_equal(cpumaskp, &next->cpus_mask)) {
+		ac = (struct affinity_context) {
+			.new_mask  = cpumaskp,
+			.flags     = 0,
+		};
+
+		// TODO consider p->group_leader as in fcs_wake
+		next->sched_class->set_cpus_allowed(next, &ac);
+		set_task_cpu(next, current_cpu);
+	}
+
+	// set next task state to running
+	ttwu_do_wakeup(next);
+
+	// As soon as we release next->pi_lock, a ttwu may attempt to add it a
+	// runqueue. However, it will be ignored, because we have already set
+	// the "next" state to running.
+	// Even if somebody else changed the state, ttwu will eventually stop
+	// because it will also need to take the "next" rq_lock, which cannot
+	// because  on the one hand, we have already migrated "next" to the
+	// current rq (if needed) and on the other hand, we already have the
+	// current rq lock, which we will not release until the context switch
+	// is done.
+	raw_spin_unlock(&next->pi_lock);
+
+	/* Promote REQ to ACT */
+	rq->clock_update_flags <<= 1;
+	update_rq_clock(rq);
+	rq->clock_update_flags = RQCF_UPDATED;
+
+	// We do not clear neither the prev task NEED_RESECHED
+	// (clear_tsk_need_resched(prev)) nor the per-cpu preempt need resched
+	// (clear_preempt_need_resched()), because we are not allowing the
+	// scheduler to take a decision on what to run next.
+
+	// swap sched_entity
+	fcs_swap_se(&prev->se, &next->se);
+	list_del_init(&prev->se.group_node);
+	list_add(&next->se.group_node, &rq->cfs_tasks);
+	fcs_swap_fair(prev, next);
+
+	// prev is no longer running
+	WRITE_ONCE(prev->on_rq, 0);
+
+	// Set current
+	RCU_INIT_POINTER(rq->curr, next);
+
+	// TODO fix psi inconsistent state error
+	migrate_disable_switch(rq, prev);
+	psi_sched_switch(prev, next, !task_on_rq_queued(prev));
+
+	// TODO enable sched_switch trace
+	trace_sched_switch(0, prev, next, TASK_INTERRUPTIBLE);
+	rq = context_switch(rq, prev, next, &rf); //unlocks rq
+
+	// Handle supurious wake ups, mostly because of
+	// "sched_ttwu_pending" (deferred ttwu) and signal handling
+	spin_lock(&current->fcs.lock);
+	for (;;) {
+		if (current->fcs.state == FCS_STATE_WAKING)
+			break;
+
+		WARN_ON_ONCE(current->fcs.state != FCS_STATE_WAITING);
+
+		pr_fcs(current, "fcs: fast: spurious wake up loop");
+
+		if (signal_pending(current)) {
+			ret = -ERESTARTSYS;
+			restart = &current->restart_block;
+			set_restart_fn(restart, fcs_restart);
+			break;
+		}
+
+		spin_unlock(&current->fcs.lock);
+
+		//int current_cpu = smp_processor_id();
+		//pr_info("%d: %d: %dwi: type: %s: slow: wait slow\n",
+		//       current_cpu, current->pid, current->fcs.wait_id, current->fcs.type);
+
+		set_current_state(TASK_INTERRUPTIBLE);
+
+		preempt_enable_no_resched();
+
+		schedule();
+
+		preempt_disable();
+		spin_lock(&current->fcs.lock);
+	}
+	current->fcs.state = FCS_STATE_RUNNING;
+	spin_unlock(&current->fcs.lock);
+	__set_current_state(TASK_RUNNING);
+
+	//pr_info("%d: %d: %dwi: fast return\n",
+	//	smp_processor_id(), current->pid, current->fcs.wait_id);
+#ifdef CONFIG_FCS_DEBUG
+	current->fcs.wait_id = -1;
+#endif
+	pr_fcs(current, "fcs: fast return");
+
+	return ret;
+out_rq:
+	rq_unlock(rq, &rf);
+out_pi:
+	raw_spin_unlock(&next->pi_lock);
+out_irq:
+	local_irq_enable();
+out_next:
+	spin_unlock(&next->fcs.lock);
+out_prev:
+	spin_unlock(&prev->fcs.lock);
+out:
+	return 1;
+}
+
+static int do_fcs(struct task_struct *next, cpumask_t *in_mask,
+		 char block, char bypass)
+{
+	int ret;
+	int current_cpu;
+	struct task_struct *prev = current;
+	const cpumask_t *cpumaskp;
+
+#ifdef CONFIG_FCS_DEBUG
+	prev->fcs.type = fcs_type(block, next != prev);
+#endif
+
+	preempt_disable();
+
+	if (in_mask) {
+		// If the user passed a cpuset that matches the current cpu,
+		// proceed as if the user passed NULL. Not having to check for
+		// the user cpuset speeds up the context switch.
+		current_cpu = smp_processor_id();
+		cpumaskp = cpumask_of(current_cpu);
+		if (cpumask_equal(in_mask, cpumaskp)) {
+			in_mask = NULL;
+		}
+	}
+
+	if (!bypass || next == prev || !block || in_mask)
+		goto slow;
+
+	ret = do_fcs_fast(next);
+	if (ret <= 0)
+		goto out;
+
+slow:
+	if (prev != next)
+		pr_fcs(next, "pov: fcs: slow path for me");
+
+	ret = do_fcs_slow(next, in_mask, block);
+#ifdef CONFIG_FCS_DEBUG
+	prev->fcs.wait_id = -1;
+#endif
+out:
+	preempt_enable_no_resched();
+
+	return ret;
+}
+
+static long fcs(pid_t pid, cpumask_t *in_mask, char block, char bypass)
+{
+	int retval;
+	struct task_struct *p = NULL;
+
+	rcu_read_lock();
+
+	p = find_process_by_pid(pid);
+	if (!p) {
+		rcu_read_unlock();
+		return -ESRCH;
+	}
+
+	/* Prevent p going away */
+	get_task_struct(p);
+	rcu_read_unlock();
+
+	if (p->flags & PF_NO_SETAFFINITY) {
+		retval = -EINVAL;
+		goto out_put_task;
+	}
+
+	if (!check_same_owner(p)) {
+		rcu_read_lock();
+		if (!ns_capable(__task_cred(p)->user_ns, CAP_SYS_NICE)) {
+			rcu_read_unlock();
+			retval = -EPERM;
+			goto out_put_task;
+		}
+		rcu_read_unlock();
+	}
+
+	retval = security_task_setscheduler(p);
+	if (retval)
+		goto out_put_task;
+
+	retval = do_fcs(p, in_mask, block, bypass);
+
+out_put_task:
+	put_task_struct(p);
+
+	return retval;
+}
+
+#define FCS_NOBLOCK (1UL<<1)
+#define FCS_BYPASS (1UL<<2)
+#define FCS_MASK (FCS_NOBLOCK | FCS_BYPASS)
+
+SYSCALL_DEFINE4(fcs, pid_t, pid, unsigned int, len, unsigned long __user *,
+		user_mask_ptr, unsigned long, flags)
+{
+	cpumask_var_t new_mask;
+	int retval;
+	char block = 1;
+	char bypass = 0;
+
+	if (flags & ~FCS_MASK)
+		return -EINVAL;
+
+	if (flags & FCS_NOBLOCK)
+		block = 0;
+
+	if (flags & FCS_BYPASS)
+		bypass = 1;
+
+	if (user_mask_ptr != NULL) {
+		if (!alloc_cpumask_var(&new_mask, GFP_KERNEL))
+			return -ENOMEM;
+		retval = get_user_cpu_mask(user_mask_ptr, len, new_mask);
+		if (retval == 0)
+			retval = fcs(pid, new_mask, block, bypass);
+		free_cpumask_var(new_mask);
+	} else {
+		retval = fcs(pid, NULL, block, bypass);
+	}
+
+	return retval;
+}
