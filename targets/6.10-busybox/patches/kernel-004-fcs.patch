+void fcs_swap_fair(struct task_struct *prev, struct task_struct *next)
+{
+	struct cfs_rq *cfs_rq;
+	struct sched_entity *se;
+
+	// detach the previous task
+	se = &prev->se;
+	for_each_sched_entity(se) {
+		cfs_rq = cfs_rq_of(se);
+		cfs_rq->curr = NULL;
+		cfs_rq->nr_running--;
+		se->on_rq = 0;
+	}
+
+	// attach the next task
+	se = &next->se;
+	for_each_sched_entity(se) {
+		cfs_rq = cfs_rq_of(se);
+		cfs_rq->curr = se;
+		cfs_rq->nr_running++;
+		se->on_rq = 1;
+	}
+
+	// clear buddies of the next task
+	se = &next->se;
+	for_each_sched_entity(se) {
+		cfs_rq = cfs_rq_of(se);
+		if (cfs_rq->next != se)
+			break;
+		cfs_rq->next = NULL;
+	}
+}
